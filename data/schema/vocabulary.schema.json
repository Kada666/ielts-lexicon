{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-lexicon.local/schema/vocabulary.schema.json",
  "title": "IELTS Lexicon Vocabulary v1",
  "type": "object", "required": ["format", "schema_version", "words"],
  "properties": {"format":{"const":"ielts-lexicon-vocabulary"},"schema_version":{"const":1},"words":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/word"}}},
  "$defs": {
    "status":{"enum":["needs_review","reviewed"]},
    "mnemonic":{"type":"object","required":["id","type","title","content","source","status","preferred"],"properties":{
      "id":{"type":"string","minLength":1},"type":{"enum":["etymology","morphology","phonetic","onomatopoeia","association","word_family"]},"title":{"type":"string"},"content":{"type":"string"},"source":{"enum":["user","codex"]},"status":{"$ref":"#/$defs/status"},"preferred":{"type":"boolean"},"reference":{"type":"string"},
      "segments":{"type":"array","items":{"type":"object","required":["part","meaning"],"properties":{"part":{"type":"string"},"meaning":{"type":"string"}}}}
    }},
    "word":{"type":"object","required":["id","word","list_ids","initial_level","origins","meaning","phonetic","part_of_speech","example","example_zh","collocations","mnemonics","content_status","transcription_status","notes"],"properties":{
      "id":{"type":"string","pattern":"^word_"},"word":{"type":"string","pattern":"^[a-zA-Z]+(?:[ '-][a-zA-Z]+)*$"},"list_ids":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":50}},"initial_level":{"enum":["unknown","uncertain"]},
      "origins":{"type":"array","minItems":1,"items":{"type":"object","required":["list","symbol","source","raw"],"properties":{"list":{"type":["integer","null"],"minimum":1,"maximum":50},"kind":{"enum":["book","listening","reading","writing","speaking","other"]},"symbol":{"enum":["○","△","练"]},"source":{"type":"string","minLength":1},"raw":{"type":"string"}}}},
      "meaning":{"type":"array","minItems":1,"items":{"type":"string"}},"phonetic":{"type":"string"},"part_of_speech":{"type":"array","items":{"type":"string"}},"example":{"type":"string"},"example_zh":{"type":"string"},"collocations":{"type":"array","items":{"type":"string"}},"mnemonics":{"type":"array","items":{"$ref":"#/$defs/mnemonic"}},"content_status":{"$ref":"#/$defs/status"},"transcription_status":{"$ref":"#/$defs/status"},"notes":{"type":"string"}
    }}
  }
}
